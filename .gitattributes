# Windows 批处理必须 CRLF，shell 脚本必须 LF，跨平台克隆/检出/打包才不会出问题
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# 开发期文件不进分发包（git archive 遵循 export-ignore）
/.gitattributes export-ignore
/.gitignore export-ignore
/package.cmd export-ignore
/package.sh export-ignore
/scripts/package.py export-ignore
/dist/ export-ignore
